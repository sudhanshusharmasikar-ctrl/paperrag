# Leave GEN_MODE=extractive to run with no API key at all.
PAPERRAG_GEN_MODE=extractive

# Switch to mistral once you have a free key from console.mistral.ai
# PAPERRAG_GEN_MODE=mistral
# MISTRAL_API_KEY=

# Set this from your own sweep, not from the default.
PAPERRAG_SIM_THRESHOLD=0.35
PAPERRAG_TOP_K=5
PAPERRAG_CHUNK_CHARS=900

# Where the embedding model runs. Leave unset to let the library choose
# (cuda, mps on a Mac, else cpu); forcing cpu on a Mac crashed (see app/config.py).
# PAPERRAG_DEVICE=cuda
